# Header tĩnh cho Cloudflare Workers. Wrangler đọc file này khi deploy asset.
# _headers không bị tải lên như file công khai.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

/manifest.webmanifest
  Content-Type: application/manifest+json

/
  Cache-Control: no-store

/index.html
  Cache-Control: no-store

/phan-tich-3d.html
  Cache-Control: no-store

# html_handling auto-trailing-slash phục vụ trang này ở /phan-tich-3d (không còn đuôi .html).
/phan-tich-3d
  Cache-Control: no-store

/*.html
  Cache-Control: no-store

/js/*
  Cache-Control: no-store

/css/*
  Cache-Control: no-store

/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# PDF quyết định phục vụ qua /gcs/docs/ trên bucket, không nằm trong asset Worker.

# JSON công suất ghi đè cùng khóa khi bổ sung số từ quyết định.
/data/htkt/cong-suat.json
  Cache-Control: public, max-age=300

/data/htkt/qd-108-htkt.json
  Cache-Control: public, max-age=86400

/data/ward-boundary.json
  Cache-Control: public, max-age=31536000, immutable

/data/gba/agg.json
  Cache-Control: public, max-age=31536000, immutable

/data/gba/bldg-overrides.geojson
  Cache-Control: public, max-age=31536000, immutable

/data/gba/qh-hientrang.json
  Cache-Control: public, max-age=31536000, immutable

/data/qhc2045/*
  Cache-Control: public, max-age=31536000, immutable

/data/chuyen-nganh/*
  Cache-Control: public, max-age=86400

/data/chuyen-nganh/index.json
  Cache-Control: public, max-age=300

/data/chuyen-nganh/schemes.json
  Cache-Control: public, max-age=300

/data/hien-trang-tam/*
  Cache-Control: public, max-age=300

/data/su-dung-dat-index.json
  Cache-Control: public, max-age=300

/data/kien-truc/*
