{
  "version": 2,
  "builds": [
    {
      "src": "api/gee.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "memory": 1024
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/gee",
      "dest": "/api/gee.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
