{
  // Worker: file tĩnh trong public/, /api chuyển Cloud Run, file >25 MiB lấy từ GCS.
  // Vercel không đọc file này. API_UPSTREAM đặt trên dashboard Cloudflare, không ghi vào đây.
  // Nếu GitHub đang nối Workers Builds, merge nhánh main sẽ deploy worker này lên workers.dev.
  "name": "qh-hue",
  "compatibility_date": "2026-10-22",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Hai trang HTML thật (/ và /phan-tich-3d.html), không phải SPA.
    // Đường không có file trả 404, không đổ nội dung index.html vào URL hỏng.
    "not_found_handling": "none",
    // / phục vụ index.html. /phan-tich-3d.html chuyển 307 tới /phan-tich-3d, không thêm dấu / cuối
    // nên CSS/JS tương đối (css/..., js/...) vẫn trỏ đúng thư mục gốc.
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/gcs/*", "/data/gba/buildings.pmtiles"]
  }
}
